all:
  hosts:
    grafana:
      ansible_host: ${grafana_ip} #public ip of grafana instance
      ansible_user: ubuntu
      ansible_ssh_private_key_file: ./devops-key

    prometheus:
      ansible_host: ${prometheus_ip} #public ip of prometheus instance 
      ansible_user: ubuntu
      ansible_ssh_private_key_file: ./devops-key

    loki:
      ansible_host: ${loki_ip} #public ip of loki instance
      ansible_user: ubuntu
      ansible_ssh_private_key_file: ./devops-key

    devops:
      ansible_host: ${devops_ip} #public ip of devops instance
      ansible_user: ubuntu
      ansible_ssh_private_key_file: ./devops-key

  children:
    monitoring:
      hosts:
        grafana:
        prometheus:
        loki:
    
    application:
      hosts:
        devops:

    project:
      children:
        monitoring:
        application:
      vars:
        ansible_user: ubuntu
        ansible_ssh_private_key_file: ./devops-key